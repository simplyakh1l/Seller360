# Cloud AI: create a Gemini API key in Google AI Studio. Never put it in VITE_* variables.
PORT=3001
HOST=127.0.0.1
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_MS=25000
# Cloud alternatives: set LLM_PROVIDER=gemini or openai and supply its key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# LLM_PROVIDER=demo explicitly selects the limited rules-only fallback.

# Hosted runtime variables are configured by netlify.toml.
AI_REQUESTS_PER_HOUR=20
# Optional local AI: LLM_PROVIDER=ollama; requires Ollama and npm run ai:setup.
